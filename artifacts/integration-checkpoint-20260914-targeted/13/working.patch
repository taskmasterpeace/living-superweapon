 });
+
+test('weighted surface velocity uses free corners without crossing a real corner contact',()=>{
+ const f=new Fighter(ROSTER.find(d=>d.id==='sol'));try{
+  f._animate(0);const cloth=new RagdollCape(f.parts,new T.Vector3()),face=[40,41,53].map(i=>cloth.points[i]),[a,b,c]=face;
+  a.pos.set(1.991,5,-2);a.prev.copy(a.pos);cloth.resolveContact(a,new T.Vector3(1.99,5,-2),new T.Vector3(-1,0,0));
+  b.pos.set(2.01,5,2);b.prev.copy(b.pos);b.prev.x+=.1;c.pos.set(4.5,7,2);c.prev.copy(c.pos);
+  const box=new T.Box3(new T.Vector3(0,0,-.1),new T.Vector3(2.004,10,.1));cloth.faces=[face];face.forEach(p=>p.faces=[face]);
+  cloth.bodies=[{box,worldBox:box.clone(),matrix:new T.Matrix4(),inverse:new T.Matrix4()}];cloth.covers=[];cloth.collideSurface({heightAt:()=>0});
+  assert.ok(a.pos.x-a.prev.x<=1e-9,'surface stabilization drove the real corner inward');
+  assert.ok((a.pos.x-a.prev.x+b.pos.x-b.prev.x)/2>=-1e-9,'protecting the corner abandoned the active surface sample');
+  assert.ok(a.pos.x<=1.99+1e-9&&(a.pos.x+b.pos.x)/2>2.004,'both position constraints must remain clear');
+ }finally{f.dispose();}
+});
+
+test('a native vertex contact releases its plane after sliding beyond the finite body face',()=>{
+ const f=new Fighter(ROSTER.find(d=>d.id==='sol'));try{
+  const cloth=new RagdollCape(f.parts,new T.Vector3()),p=cloth.points[40];
+  const box=new T.Box3(new T.Vector3(0,0,-1),new T.Vector3(2,3,1));
+  const body={box,worldBox:box.clone(),matrix:new T.Matrix4(),inverse:new T.Matrix4()};
+  cloth.colliders=[body];cloth.covers=[];p.pos.set(1.999,1,0);p.prev.copy(p.pos);cloth.collide(p,{heightAt:()=>-10});
+  assert.ok(p.pos.x>2,'fixture failed to acquire body face');
+  p.pos.z=2;p.prev.z=2;
+  assert.ok(cloth.resolveContact(p,new T.Vector3(1,1,2),new T.Vector3(-1,0,0)),'finite face left a fictitious infinite plane');
+  assert.ok(Math.abs(p.pos.x-1)<1e-9);
+ }finally{f.dispose();}
+});
