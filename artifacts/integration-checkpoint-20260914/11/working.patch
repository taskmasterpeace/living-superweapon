+// One missile mesh (a lit dart with a booster flame), built along +Z. game.js aligns +Z to velocity
+// each frame and tracks it in `_simMissiles`; returned mats are disposed on teardown.
+export function buildSimMissile(THREE) {
+  const g = new THREE.Group();
+  const bodyMat = new THREE.MeshStandardMaterial({ color: 0xd8d4c8, roughness: 0.5, metalness: 0.3, emissive: 0x1a0a04 });
+  const flameMat = new THREE.MeshBasicMaterial({ color: 0xffb020 });
+  const body = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.5, 5, 8), bodyMat); body.rotation.x = Math.PI / 2; g.add(body);
+  const nose = new THREE.Mesh(new THREE.ConeGeometry(0.55, 1.6, 8), bodyMat); nose.rotation.x = Math.PI / 2; nose.position.z = 3.3; g.add(nose);
+  const flame = new THREE.Mesh(new THREE.ConeGeometry(0.6, 2.6, 6), flameMat); flame.rotation.x = -Math.PI / 2; flame.position.z = -3.4; g.add(flame);
+  return { group: g, mats: [bodyMat, flameMat] };
+}
