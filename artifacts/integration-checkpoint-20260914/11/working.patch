+// closest approach of a straight-flying missile (dir·speed) to a target moving at vel
+function closest(from, dir, speed, target, vel, dt = 0.01, steps = 400) {
+  let min = Infinity;
+  for (let i = 0; i <= steps; i++) {
+    const t = i * dt;
+    const mx = from.x + dir.x * speed * t, my = from.y + dir.y * speed * t, mz = from.z + dir.z * speed * t;
+    const tx = target.x + vel.x * t, ty = target.y + vel.y * t, tz = target.z + vel.z * t;
+    min = Math.min(min, Math.hypot(mx - tx, my - ty, mz - tz));
+  }
+  return min;
+}
+
+test('the missile LEADS a crossing target — a straight-at shot would miss, the lead connects', () => {
+  const from = { x: 0, y: 0, z: 0 }, target = { x: 0, y: 0, z: 200 }, vel = { x: 45, y: 0, z: 0 };
+  const lead = aaLead(from, target, vel, AA.speed);
+  assert.ok(lead.x > 0.05, `lead points AHEAD into the target's motion (x=${lead.x.toFixed(3)})`);
+  // aiming straight at where the target IS now (down +z) sails behind a crossing target
+  const straightMiss = closest(from, { x: 0, y: 0, z: 1 }, AA.speed, target, vel);
+  const ledMiss = closest(from, lead, AA.speed, target, vel);
+  assert.ok(ledMiss < AA.hitR, `the led shot passes within the kill radius (${ledMiss.toFixed(2)}u < ${AA.hitR})`);
+  assert.ok(straightMiss > ledMiss * 3, `leading matters: straight ${straightMiss.toFixed(1)}u vs led ${ledMiss.toFixed(1)}u`);
+});
+
+test('aaLead never returns a NaN direction, even for a stationary or supersonic target', () => {
+  for (const vel of [{ x: 0, y: 0, z: 0 }, { x: 400, y: 0, z: 0 }, null]) {
+    const d = aaLead({ x: 0, y: 0, z: 0 }, { x: 10, y: 5, z: 30 }, vel, AA.speed);
+    assert.ok(Number.isFinite(d.x) && Number.isFinite(d.y) && Number.isFinite(d.z), `finite dir for vel ${JSON.stringify(vel)}`);
+    assert.ok(Math.abs(Math.hypot(d.x, d.y, d.z) - 1) < 1e-6, 'unit length');
+  }
+});
+
+test('homing steer curves a missile onto a target it was fired past — but the turn is CAPPED', () => {
+  // fired straight down +z, target off to the side: it must curve in AND respect the turn-rate cap
+  const target = { x: 120, y: 0, z: 120 };
+  let pos = { x: 0, y: 0, z: 0 }, vel = { x: 0, y: 0, z: AA.speed };
+  const start = Math.hypot(target.x - pos.x, target.z - pos.z);
+  let minDist = start, worstTurn = 0, dt = 0.02;
+  for (let i = 0; i < 250; i++) {
+    const prev = { x: vel.x, y: vel.y, z: vel.z };
+    vel = aaSteer(pos, vel, target, AA.speed, AA.turnRate, dt);
+    // heading change this step must not exceed the cap (+ float slack)
+    let dot = (prev.x * vel.x + prev.y * vel.y + prev.z * vel.z) / (AA.speed * AA.speed);
+    dot = Math.max(-1, Math.min(1, dot));
+    worstTurn = Math.max(worstTurn, Math.acos(dot));
+    pos = { x: pos.x + vel.x * dt, y: pos.y + vel.y * dt, z: pos.z + vel.z * dt };
+    minDist = Math.min(minDist, Math.hypot(target.x - pos.x, target.y - pos.y, target.z - pos.z));
+  }
+  assert.ok(minDist < AA.hitR, `homing brings it home (closest ${minDist.toFixed(2)}u < ${AA.hitR})`);
+  assert.ok(worstTurn <= AA.turnRate * dt + 1e-3, `turn capped (${worstTurn.toFixed(4)} <= ${(AA.turnRate * dt).toFixed(4)})`);
+});
