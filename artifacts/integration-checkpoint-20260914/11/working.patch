+// THE MISSILES themselves. Tuned as a proving-ground threat, not a kill box — they can be out-flown.
+export const AA = {
+  range: 620,       // a turret only engages a target within this ground distance
+  aimTol: 0.5,      // must be swivelled to within this many radians of the target before it launches
+  cooldown: 2.6,    // seconds between launches per turret (jittered ±20% so volleys stagger)
+  speed: 168,       // missile cruise — a shade faster than a plane, so a straight run gets caught
+  turnRate: 2.2,    // rad/s steering cap: fast enough to chase, slow enough that a hard turn shakes it
+  hitR: 9,          // proximity-detonation radius
+  life: 6,          // self-destruct after this many seconds if it never connects
+  damage: 14,       // light — a warning shot with teeth, not an execution
+  minY: 22,         // a target must be at least this far above the base floor to count as airborne
+};
+
+// First-order intercept LEAD: the unit direction a `speed` missile launched from `from` should take
+// to meet a target now at `target` moving at `vel`. Solves |r + v·t| = speed·t for the earliest
+// positive t, then aims at the meet point. Falls back to straight-at-target when there's no solution
+// (target faster than the missile, or standing still). Plain {x,y,z} in and out — no THREE, testable.
+export function aaLead(from, target, vel, speed) {
+  const rx = target.x - from.x, ry = (target.y || 0) - (from.y || 0), rz = target.z - from.z;
+  const vx = (vel && vel.x) || 0, vy = (vel && vel.y) || 0, vz = (vel && vel.z) || 0;
+  const a = vx * vx + vy * vy + vz * vz - speed * speed;
+  const b = 2 * (rx * vx + ry * vy + rz * vz);
+  const c = rx * rx + ry * ry + rz * rz;
+  let t = 0;
+  if (Math.abs(a) < 1e-6) { t = (b < 0) ? -c / b : 0; }
+  else {
+    const disc = b * b - 4 * a * c;
+    if (disc >= 0) {
+      const sq = Math.sqrt(disc), t1 = (-b - sq) / (2 * a), t2 = (-b + sq) / (2 * a);
+      t = Math.min(t1 > 1e-4 ? t1 : Infinity, t2 > 1e-4 ? t2 : Infinity);
+      if (!Number.isFinite(t)) t = 0;
+    }
+  }
+  const mx = rx + vx * t, my = ry + vy * t, mz = rz + vz * t;
+  const L = Math.hypot(mx, my, mz) || 1;
+  return { x: mx / L, y: my / L, z: mz / L };
+}
+
+// HOMING steer: rotate a missile's velocity toward the (moving) target, capped at `turnRate` so a
+// hard-turning plane can out-run the lock. Returns the new velocity at fixed `speed`. A slerp of the
+// heading, not a snap — a snap would make the missile un-dodgeable. Plain vectors, no THREE.
+export function aaSteer(pos, vel, target, speed, turnRate, dt) {
+  const dx = target.x - pos.x, dy = (target.y || 0) - (pos.y || 0), dz = target.z - pos.z;
+  const dl = Math.hypot(dx, dy, dz) || 1;
+  const wx = dx / dl, wy = dy / dl, wz = dz / dl;
+  const vl = Math.hypot(vel.x, vel.y, vel.z) || 1;
+  const cx = vel.x / vl, cy = vel.y / vl, cz = vel.z / vl;
+  let dot = cx * wx + cy * wy + cz * wz; dot = Math.max(-1, Math.min(1, dot));
+  const ang = Math.acos(dot), step = turnRate * dt;
+  let nx, ny, nz;
+  if (ang <= step || ang < 1e-4) { nx = wx; ny = wy; nz = wz; }
+  else {
+    const s = Math.sin(ang), f = step / ang, a0 = Math.sin((1 - f) * ang) / s, a1 = Math.sin(f * ang) / s;
+    nx = cx * a0 + wx * a1; ny = cy * a0 + wy * a1; nz = cz * a0 + wz * a1;
+    const nl = Math.hypot(nx, ny, nz) || 1; nx /= nl; ny /= nl; nz /= nl;
+  }
+  return { x: nx * speed, y: ny * speed, z: nz * speed };
+}
